{
  "name": "kalpa-shan-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "predev": "npm run build -w kalpa-shan",
    "dev": "concurrently -k -n core,app -c cyan,magenta \"npm run dev -w kalpa-shan\" \"npm run dev -w playground\"",
    "build": "npm run build --workspaces",
    "pretypecheck": "npm run build -w kalpa-shan",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2"
  }
}
